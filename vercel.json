{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/business",
      "destination": "/business/index.html"
    },
    {
      "source": "/ca-firms",
      "destination": "/ca-firms/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/stories",
      "destination": "/stories/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/stories/every-invoice-looked-fine",
      "destination": "/stories/every-invoice-looked-fine/index.html"
    },
    {
      "source": "/stories/the-second-job",
      "destination": "/stories/the-second-job/index.html"
    },
    {
      "source": "/blog/through-the-glass",
      "destination": "/blog/through-the-glass/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/business",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/business",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/stories/every-invoice-looked-fine/",
      "destination": "/stories/every-invoice-looked-fine",
      "permanent": true
    },
    {
      "source": "/stories/every-invoice-looked-fine/index.html",
      "destination": "/stories/every-invoice-looked-fine",
      "permanent": true
    },
    {
      "source": "/stories/the-second-job/",
      "destination": "/stories/the-second-job",
      "permanent": true
    },
    {
      "source": "/stories/the-second-job/index.html",
      "destination": "/stories/the-second-job",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/privacy/index.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/stories/",
      "destination": "/stories",
      "permanent": true
    },
    {
      "source": "/stories/index.html",
      "destination": "/stories",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/through-the-glass/",
      "destination": "/blog/through-the-glass",
      "permanent": true
    },
    {
      "source": "/blog/through-the-glass/index.html",
      "destination": "/blog/through-the-glass",
      "permanent": true
    },
    {
      "source": "/insights/through-the-glass",
      "destination": "/blog/through-the-glass",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/stories/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/blog/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/screens/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:file(og-geniuscfo.png|logo-on-paper.png|logo-lockup.svg|logo-wordmark-dark.svg|favicon.svg|favicon.ico|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:file(site.css|story.css|legal.css|site.js|site-v4.css|site-v4.js|logo-band.js|geniuscfo-logo-animation.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
